# Copy this file to .env and fill in real values. Never commit .env.

PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASS=your_mysql_password
DB_NAME=bank_loan_system

ACCESS_SECRET=change_me_access_secret
REFRESH_SECRET=change_me_refresh_secret
JWT_SECRET=change_me_jwt_secret

ACCESS_TOKEN_EXPIRY=3h
REFRESH_TOKEN_EXPIRY=8h

# Nodemailer (Gmail-style app password or your provider’s credentials)
MY_Email=your_email@example.com
EMAIL_PASS=your_email_app_password
